# =============================================================================
# Secrets are managed by Doppler (https://dashboard.doppler.com/workplace/projects)
# Run `doppler setup` to link this repo if not already configured.
# Run `doppler run -- <command>` to inject secrets automatically.
#
# If you don't use Doppler, copy this file to .env and fill in the values below.
# =============================================================================

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@ep-example-123456.us-east-2.aws.neon.tech/neondb

# Clerk (authentication)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY

# Polar (payments)
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# Resend (transactional emails — optional; skip to disable emails)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=ClubOS <bookings@yourdomain.com>

# Booking self-service token secret (falls back to CRON_SECRET)
BOOKING_TOKEN_SECRET=your-booking-token-secret

# Cron/Auth
CRON_SECRET=your-cron-bearer-token
SEED_PASSWORD=your-seed-script-password

# Sentry (optional — disable by leaving unset)
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
