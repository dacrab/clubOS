{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": false,
		"checkJs": false,
		"sourceMap": true,
		"types": [
			"$app/types",
			"svelte",
			"node"
		],
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false
	},
	"exclude": [
		
	],
	"include": [
		"src",
		"vite.config.ts",
		"drizzle.config.ts"
	]
}
