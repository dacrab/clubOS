{
  "name": "clubos-svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "doppler run -- vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && knip && biome check .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun scripts/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.1.3",
    "knip": "^6.26.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@clerk/backend": "^3.13.2",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.23.0",
    "@sentry/sveltekit": "^11.8.0",
    "bits-ui": "^2.18.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "svelte-clerk": "^1.1.11",
    "svelte-sonner": "^1.1.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "cookie": ">=0.7.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
