{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.{svelte,ts}",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,svelte}",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss"
  ],
  "ignore": [],
  "paths": {
    "$app/*": [
      ".svelte-kit/types/app/*"
    ],
    "#lib/*": [
      "src/lib/*"
    ]
  },
  "ignoreUnresolved": [],
  "ignoreBinaries": [
    "doppler"
  ]
}
